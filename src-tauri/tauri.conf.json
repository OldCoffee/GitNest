{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitNest",
  "version": "0.1.0",
  "identifier": "io.github.detachhead.gitnest",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GitNest",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 650,
        "backgroundColor": "#1e1f22"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": [
        "https://github.com/DetachHead/rebased/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": ""
    }
  }
}
